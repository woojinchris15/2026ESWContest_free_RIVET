<?xml version="1.0"?>
<robot name="cubic_c1" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="body_color"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="wheel_color"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="caster_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
  <material name="sensor_color"><color rgba="0.0 0.5 0.8 1.0"/></material>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.0755" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.1405" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.355 0.208"/>
      </geometry>
      <material name="body_color"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.1405" rpy="0 0 0"/>
      <geometry>
        <box size="0.455 0.355 0.208"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 0.1405" rpy="0 0 0"/>
      <inertia ixx="0.211" ixy="0.0" ixz="0.0" iyy="0.313" iyz="0.0" izz="0.416"/>
    </inertial>
  </link>

  <xacro:macro name="main_wheel" params="prefix y_reflect">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.0755"/>
        </geometry>
        <material name="wheel_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.570796 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.0755"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.0"/>
        <inertia ixx="0.0015" ixy="0" ixz="0" iyy="0.0015" iyz="0" izz="0.0028"/>
      </inertial>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}_link"/>
      <origin xyz="0 ${y_reflect * 0.1975} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:main_wheel prefix="left" y_reflect="1"/>
  <xacro:main_wheel prefix="right" y_reflect="-1"/>

  <xacro:macro name="caster_wheel" params="prefix x_reflect y_reflect">
    <link name="caster_${prefix}_link">
      <visual>
        <geometry>
          <sphere radius="0.0381"/>
        </geometry>
        <material name="caster_color"/>
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.0381"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.3"/>
        <inertia ixx="0.00017" ixy="0" ixz="0" iyy="0.00017" iyz="0" izz="0.00017"/>
      </inertial>
    </link>

    <joint name="caster_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="caster_${prefix}_link"/>
      <origin xyz="${x_reflect * 0.19} ${y_reflect * 0.14} -0.0374" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:caster_wheel prefix="front_left"  x_reflect="1"  y_reflect="1"/>
  <xacro:caster_wheel prefix="front_right" x_reflect="1"  y_reflect="-1"/>
  <xacro:caster_wheel prefix="rear_left"   x_reflect="-1" y_reflect="1"/>
  <xacro:caster_wheel prefix="rear_right"  x_reflect="-1" y_reflect="-1"/>

  <xacro:macro name="rplidar_c1" params="prefix x_offset yaw_angle">
    <link name="lidar_${prefix}_link">
      <visual>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.038"/>
        </geometry>
        <material name="sensor_color"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.02" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.04" radius="0.038"/>
        </geometry>
      </collision>
    </link>

    <joint name="lidar_${prefix}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="lidar_${prefix}_link"/>
      <origin xyz="${x_offset} 0 0.2445" rpy="0 0 ${yaw_angle}"/>
    </joint>
  </xacro:macro>

  <xacro:rplidar_c1 prefix="front" x_offset="0.14125"  yaw_angle="3.141592"/>
  <xacro:rplidar_c1 prefix="rear"  x_offset="-0.14125" yaw_angle="0"/>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="sensor_color"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.103 0.0025 0.095" rpy="0 0 0"/>
  </joint>

</robot>
