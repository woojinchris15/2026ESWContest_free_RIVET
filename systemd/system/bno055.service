[Unit]
Description=CUBIC BNO055 IMU
After=multi-user.target

[Service]
Type=simple
User=cubic
WorkingDirectory=/home/cubic/cubic_ws
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/cubic/cubic_ws/install/setup.bash && ros2 run bno055 bno055 --ros-args --params-file /home/cubic/cubic_ws/src/cubic_bringup/config/bno055_params.yaml'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
