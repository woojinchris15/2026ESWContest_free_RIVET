[Unit]
Description=CUBIC Nav2 Navigation
After=cubic-localization.service
Requires=cubic-localization.service
Conflicts=cubic-slam.service

[Service]
Type=simple
User=cubic
Environment=HOME=/home/cubic
WorkingDirectory=/home/cubic

ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/cubic/cubic_ws/install/setup.bash && exec ros2 launch nav2_bringup navigation_launch.py params_file:=/home/cubic/cubic_ws/src/cubic_navigation/config/nav2_params.yaml use_sim_time:=False autostart:=True'

KillSignal=SIGINT
TimeoutStopSec=8

Restart=on-failure
RestartSec=2
